<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lesson_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="7dp"
    android:orientation="vertical" android:background="@drawable/widget_item_background" android:padding="12dp">
    <TextView android:id="@+id/lesson_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:textColor="@color/widget_accent" />
    <TextView android:id="@+id/lesson_subject" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:textColor="@color/widget_text" android:paddingTop="3dp" />
    <TextView android:id="@+id/lesson_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:textColor="@color/widget_secondary" android:paddingTop="3dp" />
</LinearLayout>
